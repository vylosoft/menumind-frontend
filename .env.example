# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE / POSTGRESQL DATABASE CREDENTIALS:
# Configure connection to Supabase database for persistent storage of POS sales, recipes, and forecasts.
DATABASE_URL="postgresql://postgres.ognarhapvjisjespxdlc:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
SUPABASE_DB_HOST="aws-0-eu-west-1.pooler.supabase.com"
SUPABASE_DB_PORT="5432"
SUPABASE_DB_USER="postgres.ognarhapvjisjespxdlc"
SUPABASE_DB_PASSWORD="YOUR_SUPABASE_PASSWORD"
SUPABASE_DB_NAME="postgres"

# MenuMind ingestion API (menumind-api) base URL
VITE_API_BASE_URL="http://localhost:4000"
